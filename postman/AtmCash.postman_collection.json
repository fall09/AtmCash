{
  "info": {
    "_postman_id": "fb2da586-2bb0-4ae3-96df-fa3d4164c803",
    "name": "ATM Cash Management",
    "description": "End-to-end scenario. Run the 'Main scenario' folder in order (Collection Runner), against http://localhost:8080 (docker compose up).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Main scenario",
      "item": [
        {
          "name": "00 Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Healthy', () => pm.expect(pm.response.text()).to.eql('Healthy'));"
                ]
              }
            }
          ]
        },
        {
          "name": "01 Create ATM",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/atms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "atms"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{atmName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('atmName', 'ATM-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('atmId', j.id);",
                  "pm.test('Status UNCONFIGURED', () => pm.expect(j.status).to.eql('UNCONFIGURED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Configure cassettes (slots 2-5)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/atms/{{atmId}}/cassettes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "atms",
                "{{atmId}}",
                "cassettes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cassettes\": [\n    {\n      \"slot\": 2,\n      \"currency\": \"TRY\",\n      \"denomination\": 100\n    },\n    {\n      \"slot\": 3,\n      \"currency\": \"TRY\",\n      \"denomination\": 50\n    },\n    {\n      \"slot\": 4,\n      \"currency\": \"TRY\",\n      \"denomination\": 20\n    },\n    {\n      \"slot\": 5,\n      \"currency\": \"USD\",\n      \"denomination\": 100\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status CONFIGURED', () => pm.expect(pm.response.json().status).to.eql('CONFIGURED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Load cash",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User",
                "value": "operator1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/atms/{{atmId}}/load",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "atms",
                "{{atmId}}",
                "load"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cassettes\": [\n    {\n      \"slot\": 2,\n      \"count\": 50\n    },\n    {\n      \"slot\": 3,\n      \"count\": 50\n    },\n    {\n      \"slot\": 4,\n      \"count\": 50\n    },\n    {\n      \"slot\": 5,\n      \"count\": 20\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Status LOADED', () => pm.expect(j.status).to.eql('LOADED'));",
                  "const try_ = j.totals.find(t => t.currency === 'TRY');",
                  "pm.test('TRY total = 8500', () => pm.expect(try_.amount).to.eql(8500));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Put in service",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/atms/{{atmId}}/transitions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "atms",
                "{{atmId}}",
                "transitions"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target\": \"IN_SERVICE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Status IN_SERVICE', () => pm.expect(pm.response.json().status).to.eql('IN_SERVICE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Withdrawal quote (TRY 160, exact)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/atms/{{atmId}}/withdrawals/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "atms",
                "{{atmId}}",
                "withdrawals",
                "quotes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"{{cardNumber}}\",\n  \"currency\": \"TRY\",\n  \"amount\": 160\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.collectionVariables.set('quoteId', j.quoteId);",
                  "pm.test('Exact match', () => pm.expect(j.exactMatch).to.eql(true));",
                  "pm.test('Min notes: 100x1 + 20x3 = 4 notes', () => pm.expect(j.options[0].totalNotes).to.eql(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Confirm withdrawal (Idempotency-Key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quotes/{{quoteId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quotes",
                "{{quoteId}}",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Dispensed 160', () => pm.expect(j.dispensedAmount).to.eql(160));",
                  "pm.test('Not a replay', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.be.null);"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Confirm again, same key (idempotent replay)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quotes/{{quoteId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quotes",
                "{{quoteId}}",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Replay header set', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));",
                  "pm.test('Same result', () => pm.expect(pm.response.json().dispensedAmount).to.eql(160));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Confirm again, NEW key (must fail 409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/quotes/{{quoteId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "quotes",
                "{{quoteId}}",
                "confirm"
