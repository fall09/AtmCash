          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code', () => pm.expect(pm.response.json().code).to.eql('QUOTE_ALREADY_CONFIRMED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Inventory after withdrawal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/atms/{{atmId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "atms",
                "{{atmId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Slot 2 = 49 notes', () => pm.expect(j.cassettes.find(c => c.slot === 2).count).to.eql(49));",
                  "pm.test('Slot 4 = 47 notes', () => pm.expect(j.cassettes.find(c => c.slot === 4).count).to.eql(47));",
                  "pm.test('TRY total = 8340', () => pm.expect(j.totals.find(t => t.currency === 'TRY').amount).to.eql(8340));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Deposit (2x TRY100, 1x EUR50, 2 unrecognised)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-User",
                "value": "customer1"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/atms/{{atmId}}/deposits",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "atms",
                "{{atmId}}",
                "deposits"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": [\n    {\n      \"currency\": \"TRY\",\n      \"denomination\": 100,\n      \"count\": 2\n    },\n    {\n      \"currency\": \"EUR\",\n      \"denomination\": 50,\n      \"count\": 1\n    }\n  ],\n  \"unrecognizedCount\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('TRY 100s go to recycling cassette slot 2', () => pm.expect(j.accepted.find(a => a.currency === 'TRY').cassetteSlot).to.eql(2));",
                  "pm.test('EUR goes to deposit cassette (slot 1)', () => pm.expect(j.accepted.find(a => a.currency === 'EUR').cassetteSlot).to.eql(1));",
                  "pm.test('Unrecognised notes returned', () => pm.expect(j.returned.some(r => r.reason === 'UNRECOGNISED' && r.count === 2)).to.eql(true));"
                ]
              }
            }
          ]
        },
